# Google Sheets webhook URL from Google Apps Script deployment
NEXT_PUBLIC_SHEET_WEBHOOK_URL=your_google_apps_script_url_here

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Loaded by the browser ONLY after the visitor accepts cookies (see CookieConsent).
# Leave blank to disable Google Analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sanity — copy to .env and fill in your own values.
# Find these at https://www.sanity.io/manage after creating your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=aghe2n16
NEXT_PUBLIC_SANITY_DATASET=aczen

# --- Blog automation (Sheets -> Gemini -> Sanity, fires daily via Vercel Cron) ---
# Sanity write token: create at https://www.sanity.io/manage -> API -> Tokens (Editor or Write).
SANITY_WRITE_TOKEN=
# Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional model overrides
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Apps Script /exec URL from scripts/google-apps-script/Code.gs (server-only)
BLOG_SHEET_WEBHOOK_URL=
# Shared secret — must match SHARED_SECRET script property on the Apps Script side
BLOG_SHEET_SECRET=
# Random string. Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- /axe founder analytics (Supabase project `aczenin`, ap-southeast-1) ---
# Checklist for what to set in the Vercel project. NAMES ONLY here — this file
# is committed to git, so it must never carry a real value.
#
# The three marked SENSITIVE below must be added in Vercel as *Sensitive*
# environment variables. A sensitive variable is write-only: once saved, not
# even a team admin can read it back from the dashboard. That property is the
# whole point — it is what keeps a leaked dashboard session from also leaking
# the keys, and it cannot be applied retroactively, so set them as sensitive the
# first time rather than converting them later.

# Supabase REST endpoint. Public by nature — it is in every browser request.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key. Public by design and safe to ship: RLS is enabled and
# FORCED on all four analytics tables with zero policies, and anon is revoked
# from them outright, so this key can read nothing in the analytics schema.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SENSITIVE. Service-role key — bypasses RLS completely and is the only way the
# dashboard can read anything. Server-side use only; it must never reach a
# client bundle. Anyone holding this reads all analytics.
SUPABASE_SERVICE_ROLE_KEY=
# SENSITIVE. The /axe password hash, as `saltHex:keyHex` from Node's
# crypto.scryptSync(password, saltBuf, 64).
# THERE IS NO FALLBACK AND THE GATE FAILS CLOSED WITHOUT THIS: if the variable
# is missing, every password is rejected and nobody can reach the dashboard.
# That is deliberate. The password is a dictionary word by the founder's own
# decision, and the reason that remains acceptable is precisely that the hash
# never enters git — a hardcoded fallback constant in the source would restore
# offline cracking and remove the only thing protecting a weak password.
AXE_GATE_HASH=
# SENSITIVE. Salt mixed into every visitor hash, combined with the current date
# so the hash rotates daily.
# This is the legal basis of the collection, not a tuning knob. Without the salt
# the hash is reversible to an IP by exhaustive search; with a *fixed* salt the
# data is merely pseudonymous and stays inside DPDP Act 2023 / GDPR scope. The
# daily rotation is what makes it anonymous. Changing this value resets all
# visitor identity, so historical unique-visitor counts stop being comparable.
AXE_SALT=
# SENSITIVE. HMAC key signing the /axe session cookie's expiry. Anyone who knows
# it can mint a valid session and walk past the password entirely. Rotating it
# is the way to log every existing session out at once.
AXE_COOKIE_SECRET=

# --- /Finathon/axe/26 registrations dashboard ---
# SENSITIVE. The /Finathon/axe/26 password hash, as `saltHex:keyHex` from Node's
# crypto.scryptSync(password, saltBuf, 64) — the same format as AXE_GATE_HASH.
# Generate with:
#   node -e "const{randomBytes,scryptSync}=require('node:crypto');const s=randomBytes(16);console.log(s.toString('hex')+':'+scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
# DELIBERATELY SEPARATE FROM AXE_GATE_HASH: this dashboard holds registrants'
# names, roll numbers and payment references and is read by whoever runs the
# event, while /axe holds anonymous traffic counts and is read by the founder.
# One shared password would hand an event volunteer the analytics dashboard too.
# THERE IS NO FALLBACK AND THE GATE FAILS CLOSED WITHOUT THIS.
FINATHON_GATE_HASH=

# --- Finathon confirmation email (Zoho Mail SMTP) ---
# Sent to the team lead (members on CC) after a registration is saved.
# Mailbox that sends the mail. Zoho requires From to match it.
ZOHO_SMTP_USER=team@aczen.in
# SENSITIVE. A Zoho APP-SPECIFIC password for that mailbox
# (Zoho Mail -> My Account -> Security -> App Passwords), not the login password.
# If unset, registrations still work and the email is skipped with a log line.
ZOHO_SMTP_PASSWORD=
# smtp.zoho.in for India-hosted accounts (default), smtp.zoho.com for US.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
# Email design: classic (default), minimal or ticket.
# Preview them with: node scripts/preview-finathon-mail.mjs
FINATHON_MAIL_TEMPLATE=classic

# --- Aczen AI Studio (/ai-studio, /ai-studio/axe, /api/ai/v1) ---
# Generate the first four with: node scripts/ai-studio-secrets.mjs --admin
# All SENSITIVE. Every one fails closed: if it's missing, the feature refuses to work.
#
# SENSITIVE. HMAC key for team-lead session cookies (>= 32 chars). Rotating it signs everyone out.
AI_STUDIO_SESSION_SECRET=
# SENSITIVE. HMAC key for the admin session cookie. Separate from the one above on purpose.
AI_STUDIO_ADMIN_SESSION_SECRET=
# SENSITIVE. Pepper for API-key HMACs and IP/email hashes. NEVER ROTATE once keys exist:
# changing it makes every issued API key invalid.
AI_STUDIO_KEY_PEPPER=
# SENSITIVE. Admin password hash, `saltHex:keyHex` (same format as AXE_GATE_HASH). Never the plain password.
AI_STUDIO_ADMIN_PASSWORD_HASH=
# Optional. Comma-separated exact IPs allowed to reach /ai-studio/axe. Unset = any IP.
AI_STUDIO_ADMIN_IP_ALLOWLIST=
# Optional. Alert recipients (comma-separated). Defaults to ZOHO_SMTP_USER.
AI_STUDIO_ALERT_EMAIL=
# Break-glass: "1" refuses every API request with 503, even if the database is down.
AI_STUDIO_KILL_SWITCH=
#
# Upstream harness (RAG + guardrails around Vertex AI / Gemini).
# "stub" (development only) returns canned replies so the whole flow can be tested.
AI_HARNESS_URL=
# SENSITIVE. The single master key for the harness. Users never see it.
AI_HARNESS_API_KEY=
# Optional. Header carrying the key (default "authorization") and its scheme (default "Bearer").
AI_HARNESS_AUTH_HEADER=
AI_HARNESS_AUTH_SCHEME=
# Optional. Comma-separated endpoints users may call (default "chat/completions").
AI_HARNESS_ALLOWED_PATHS=
# Optional. Body field that caps output tokens (default "max_tokens").
AI_HARNESS_MAX_TOKENS_FIELD=
# Optional. Forced into body.model so callers can't choose a different model.
AI_HARNESS_MODEL=
# Optional. Upstream timeout in ms (default 55000, max 58000).
AI_HARNESS_TIMEOUT_MS=
