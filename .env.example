# Google Sheets webhook URL from Google Apps Script deployment
NEXT_PUBLIC_SHEET_WEBHOOK_URL=your_google_apps_script_url_here

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Loaded by the browser ONLY after the visitor accepts cookies (see CookieConsent).
# Leave blank to disable Google Analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sanity — copy to .env and fill in your own values.
# Find these at https://www.sanity.io/manage after creating your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=aghe2n16
NEXT_PUBLIC_SANITY_DATASET=aczen

# --- Blog automation (Sheets -> Gemini -> Sanity, fires daily via Vercel Cron) ---
# Sanity write token: create at https://www.sanity.io/manage -> API -> Tokens (Editor or Write).
SANITY_WRITE_TOKEN=
# Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional model overrides
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Apps Script /exec URL from scripts/google-apps-script/Code.gs (server-only)
BLOG_SHEET_WEBHOOK_URL=
# Shared secret — must match SHARED_SECRET script property on the Apps Script side
BLOG_SHEET_SECRET=
# Random string. Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- /axe founder analytics (Supabase project `aczenin`, ap-southeast-1) ---
# Checklist for what to set in the Vercel project. NAMES ONLY here — this file
# is committed to git, so it must never carry a real value.
#
# The three marked SENSITIVE below must be added in Vercel as *Sensitive*
# environment variables. A sensitive variable is write-only: once saved, not
# even a team admin can read it back from the dashboard. That property is the
# whole point — it is what keeps a leaked dashboard session from also leaking
# the keys, and it cannot be applied retroactively, so set them as sensitive the
# first time rather than converting them later.

# Supabase REST endpoint. Public by nature — it is in every browser request.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key. Public by design and safe to ship: RLS is enabled and
# FORCED on all four analytics tables with zero policies, and anon is revoked
# from them outright, so this key can read nothing in the analytics schema.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SENSITIVE. Service-role key — bypasses RLS completely and is the only way the
# dashboard can read anything. Server-side use only; it must never reach a
# client bundle. Anyone holding this reads all analytics.
SUPABASE_SERVICE_ROLE_KEY=
# SENSITIVE. The /axe password hash, as `saltHex:keyHex` from Node's
# crypto.scryptSync(password, saltBuf, 64).
# THERE IS NO FALLBACK AND THE GATE FAILS CLOSED WITHOUT THIS: if the variable
# is missing, every password is rejected and nobody can reach the dashboard.
# That is deliberate. The password is a dictionary word by the founder's own
# decision, and the reason that remains acceptable is precisely that the hash
# never enters git — a hardcoded fallback constant in the source would restore
# offline cracking and remove the only thing protecting a weak password.
AXE_GATE_HASH=
# SENSITIVE. Salt mixed into every visitor hash, combined with the current date
# so the hash rotates daily.
# This is the legal basis of the collection, not a tuning knob. Without the salt
# the hash is reversible to an IP by exhaustive search; with a *fixed* salt the
# data is merely pseudonymous and stays inside DPDP Act 2023 / GDPR scope. The
# daily rotation is what makes it anonymous. Changing this value resets all
# visitor identity, so historical unique-visitor counts stop being comparable.
AXE_SALT=
# SENSITIVE. HMAC key signing the /axe session cookie's expiry. Anyone who knows
# it can mint a valid session and walk past the password entirely. Rotating it
# is the way to log every existing session out at once.
AXE_COOKIE_SECRET=
